# Example Team Pack — Environment Variables
# These are substituted into CLAUDE.md during install.
# Copy this directory and customize for your team.

USER_NAME="Your Name"
USER_ROLE="Engineer"
USER_EMAIL="you@company.com"
USER_AID="your-id"
TEAM_DISPLAY_NAME="Your Team"

# Jira integration (optional)
JIRA_PROJECT_KEY="PROJ"
JIRA_BASE_URL="https://your-org.atlassian.net"
JIRA_CLOUD_ID="your-cloud-id"
